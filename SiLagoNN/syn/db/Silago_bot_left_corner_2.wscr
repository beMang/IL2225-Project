###################################################################

# Set the current_design #
current_design Silago_bot_left_corner

set_units -time ps -resistance kOhm -capacitance fF -voltage V -current mA
remove_wire_load_model
set_local_link_library                                                         \
{GF22FDX_SC8T_104CPP_BASE_CSC28L_FFG_0P72V_0P00V_0P00V_0P00V_M40C_ccs.db}
set_multibit_options -mode non_timing_driven
set_dont_touch [get_cells SILEGO_cell] 
create_clock [get_ports clk]  -period 60000  -waveform {0 10}
set_clock_uncertainty 300  [get_clocks clk]
set_false_path   -from [get_ports rst_n]
set compile_inbound_cell_optimization false
set compile_inbound_max_cell_percentage 10.0
1
