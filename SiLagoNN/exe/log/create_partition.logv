[01/03 09:09:20   1504s] #@ Begin verbose source ../phy/scr/floorplan.tcl (pre)
[01/03 09:09:20   1504s] @file 1: # margin around core
[01/03 09:09:20   1504s] @file 2: set margin 40
[01/03 09:09:20   1504s] @file 3: # spacing between Silago instances for routing to pins
[01/03 09:09:20   1504s] @file 4: set spacing 40
[01/03 09:09:20   1504s] @file 5: # Silago block size
[01/03 09:09:20   1504s] @file 6: set width  200
[01/03 09:09:20   1504s] @file 7: set height 200
[01/03 09:09:20   1504s] @file 8:
[01/03 09:09:20   1504s] @@file 9: create_floorplan -site SC8T_104CPP_CMOS22FDX -core_size [expr {9*$spacing + 8*$width}] [expr {3*$spacing + 2*$height}] $margin $margin $margin $margin -no_snap_to_grid
[01/03 09:09:21   1505s] 
[01/03 09:09:21   1505s] Honor LEF defined pitches for advanced node
[01/03 09:09:21   1505s] Start create_tracks
[01/03 09:09:21   1505s] **WARN: (IMPFP-325):	Floorplan of the design is resized. All current create_floorplan objects are automatically derived based on specified new create_floorplan. This may change blocks, fixed standard cells, existing routes and blockages.
[01/03 09:09:21   1506s] @file 10:
[01/03 09:09:21   1506s] @file 11: for {set i 0} {$i < 8} {incr i} {
[01/03 09:09:21   1506s] #Top row
[01/03 09:09:21   1506s]     set x1 [expr {double($margin + ($spacing * ($i+1)) + ($width * $i))}]
[01/03 09:09:21   1506s]     set y1 [expr {double($margin + ($spacing *  2   ) +  $height     )}]
[01/03 09:09:21   1506s]     set x2 [expr {double($x1 + $width )}]
[01/03 09:09:21   1506s]     set y2 [expr {double($y1 + $height)}]
[01/03 09:09:21   1506s] 
[01/03 09:09:21   1506s]     set cell [lindex ${all_partition_hinst_list} $i ]
[01/03 09:09:21   1506s]     create_boundary_constraint -type fence -hinst $cell -rects [list [list $x1 $y1 $x2 $y2]]
[01/03 09:09:21   1506s] #Bottom row
[01/03 09:09:21   1506s]     set y1 [expr {double($margin + $spacing)}]
[01/03 09:09:21   1506s]     set y2 [expr {double($y1 + $height)}]
[01/03 09:09:21   1506s] 
[01/03 09:09:21   1506s]     set j [expr {$i + 8}]
[01/03 09:09:21   1506s]     set cell [lindex ${all_partition_hinst_list} $j ]
[01/03 09:09:21   1506s]     create_boundary_constraint -type fence -hinst $cell -rects [list [list $x1 $y1 $x2 $y2]]
[01/03 09:09:21   1506s] }
[01/03 09:09:21   1506s] #@ End verbose source ../phy/scr/floorplan.tcl
